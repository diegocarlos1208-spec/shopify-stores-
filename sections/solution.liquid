{%- assign s = section.settings -%}
<section class="section solution">
  <div class="wrap">
    <div class="eyebrow">{{ s.eyebrow | default: 'The Solution' }}</div>
    <h2>{{ s.heading | default: 'Meet the Spicy Lip Plumper' }}</h2>
    <p class="lead">{{ s.intro | default: 'A glossy, tingling serum you swipe on like a lip gloss. A spicy botanical blend brings blood flow to the surface for instant fullness, while peptides and hyaluronic acid smooth and hydrate over time. No needles, no liner, no compromise.' }}</p>

    <div class="grid-4">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="pcard" {{ block.shopify_attributes }}>
            <div class="ic">{{ block.settings.icon }}</div>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="pcard"><div class="ic">🌶️</div><h3>Plumps On Contact</h3><p>A warm spicy complex boosts micro-circulation the moment it touches your lips — fuller, rosier, more defined within about five minutes.</p></div>
        <div class="pcard"><div class="ic">✨</div><h3>Smooths Lip Texture</h3><p>A tri-peptide blend supports your lips' natural collagen, softening vertical lines and lipstick bleed with daily use.</p></div>
        <div class="pcard"><div class="ic">✒️</div><h3>Redefines Your Lip Line</h3><p>The plumping effect sharpens the border of your lips, so they look sculpted and intentional even with nothing else on.</p></div>
        <div class="pcard"><div class="ic">💧</div><h3>Hydrates, Doesn't Dry</h3><p>Hyaluronic acid and vitamin E leave lips cushiony and soft — never the tight, cracked feeling cheap plumpers leave behind.</p></div>
      {%- endif -%}
    </div>

    <div class="proof">
      <span class="big">{{ s.proof1 | default: '12,000+ Verified Buyers' }}</span>
      <span>{{ s.proof2 | default: '★ 4.9 / 5 Average Rating' }}</span>
      <span>{{ s.proof3 | default: '92% saw visible plump on first use*' }}</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Solution",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Solution" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet the Spicy Lip Plumper" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "A glossy, tingling serum you swipe on like a lip gloss. A spicy botanical blend brings blood flow to the surface for instant fullness, while peptides and hyaluronic acid smooth and hydrate over time. No needles, no liner, no compromise." },
    { "type": "text", "id": "proof1", "label": "Proof stat 1", "default": "12,000+ Verified Buyers" },
    { "type": "text", "id": "proof2", "label": "Proof stat 2", "default": "★ 4.9 / 5 Average Rating" },
    { "type": "text", "id": "proof3", "label": "Proof stat 3", "default": "92% saw visible plump on first use*" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji / icon", "default": "🌶️" },
        { "type": "text", "id": "title", "label": "Title", "default": "Benefit title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the benefit." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Solution" }]
}
{% endschema %}
