{%- liquid
  assign s = section.settings
  assign p = product
  assign current_variant = p.selected_or_first_available_variant
-%}

<section class="pdp">
  <div class="wrap">
    <div class="grid">

      {%- comment -%} -------- Gallery -------- {%- endcomment -%}
      <div class="gallery" id="pdp-gallery">
        {%- if p.media.size > 0 -%}
          <div class="main">
            <img src="{{ p.featured_media.preview_image | image_url: width: 1100 }}" alt="{{ p.title }}" width="1100" height="1100" loading="eager">
          </div>
          {%- if p.media.size > 1 -%}
            <div class="thumbs">
              {%- for media in p.media limit: 6 -%}
                <button type="button" class="pdp-thumb{% if forloop.first %} active{% endif %}" data-full="{{ media.preview_image | image_url: width: 1100 }}">
                  <img src="{{ media.preview_image | image_url: width: 260 }}" alt="{{ p.title }} — view {{ forloop.index }}" loading="lazy">
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          {%- assign gallery = 'plumper-1.jpg,plumper-2.jpg,plumper-3.jpg,plumper-4.jpg,plumper-5.jpg' | split: ',' -%}
          <div class="main">
            <img src="{{ 'plumper-1.jpg' | asset_url }}" alt="{{ p.title | default: 'Spicy Lip Plumper' }}" width="1100" height="1100">
          </div>
          <div class="thumbs">
            {%- for img in gallery -%}
              <button type="button" class="pdp-thumb{% if forloop.first %} active{% endif %}" data-full="{{ img | asset_url }}">
                <img src="{{ img | asset_url }}" alt="{{ p.title | default: 'Spicy Lip Plumper' }} — view {{ forloop.index }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="mini-faq">
          <details open>
            <summary>Is it safe for sensitive lips?</summary>
            <p>Yes — patch-test on your wrist first if you're prone to irritation. No cinnamon, no parabens, dermatologist-tested.</p>
          </details>
          <details>
            <summary>How fast will it ship?</summary>
            <p>Processed within 24–48 hours, with tracking emailed the moment it ships.</p>
          </details>
          <details>
            <summary>What if it's not for me?</summary>
            <p>30-day money-back guarantee — no need to send the tube back.</p>
          </details>
        </div>
      </div>

      {%- comment -%} -------- Buy box -------- {%- endcomment -%}
      <div id="buybox">
        <div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ p.title | default: 'Spicy Lip Plumper' }}</div>
        <h1>{{ p.title | default: 'Spicy Lip Plumper — Tingle & Volume Serum' }}</h1>
        <div class="rate"><b>★★★★★</b> {{ s.rating_text | default: '4.7 · 2,000+ verified reviews' }}</div>

        <div class="price">
          <span class="now" id="priceNow">
            {%- if current_variant -%}{{ current_variant.price | money }}{%- else -%}$24.99{%- endif -%}
          </span>
          <span class="was" id="priceWas"
            {% unless current_variant.compare_at_price > current_variant.price %}style="display:none"{% endunless %}>
            {%- if current_variant.compare_at_price > current_variant.price -%}{{ current_variant.compare_at_price | money }}{%- endif -%}
          </span>
        </div>

        <p class="blurb">
          {{ p.description | strip_html | truncatewords: 55 | default: "Hydrates while it plumps — unlike tingle formulas that leave lips drier every time you use them. A warm, gentle tingle (not a burn) builds visible volume in about five minutes, and hyaluronic acid + vitamin E lock the moisture back in." }}
        </p>

        <div class="expect">
          <span>🌶️ Warm tingle, ~60 sec</span>
          <span>👄 Visible plump in 5 min</span>
          <span>💧 Hydrates, doesn't dry</span>
        </div>

        <div class="trustrow">
          <span>✓ Dermatologist-tested</span>
          <span>✓ No cinnamon irritants</span>
          <span>✓ Vegan &amp; cruelty-free</span>
        </div>

        <blockquote class="pquote">
          "Three swipes and my lips look full and defined — friends thought I'd had filler again."
          <cite>— Sarah M., verified buyer</cite>
        </blockquote>

        {%- if p != blank -%}
          {%- form 'product', p, id: 'product-form' -%}
            <input type="hidden" name="id" id="variant-id" value="{{ current_variant.id }}">

            {%- liquid
              assign has_sub = false
              assign first_plan = nil
              if product.selling_plan_groups.size > 0
                assign has_sub = true
                assign first_plan = product.selling_plan_groups.first.selling_plans.first
              endif
            -%}

            {%- unless p.has_only_default_variant -%}
              {%- liquid
                assign best_variant = p.variants.last
                assign best_pct = 0
                if best_variant.compare_at_price > best_variant.price
                  assign best_pct = best_variant.compare_at_price | minus: best_variant.price | times: 100 | divided_by: best_variant.compare_at_price
                endif
              -%}
              <div class="offer-card">
                <div class="offer-head">
                  <span class="offer-eyebrow">✨ {{ s.option_label | default: 'Bundle &amp; Save — Limited Time' }}</span>
                  {%- if best_pct > 0 -%}<span class="offer-pill">{{ best_pct }}% OFF</span>{%- endif -%}
                </div>

                <div class="bundles">
                  {%- for variant in p.variants -%}
                    {%- liquid
                      assign v_sub_price = variant.price
                      if has_sub
                        for alloc in variant.selling_plan_allocations
                          if alloc.selling_plan.id == first_plan.id
                            assign v_sub_price = alloc.price
                          endif
                        endfor
                      endif
                      assign is_popular = false
                      assign is_best = false
                      if variant.title contains '2'
                        assign is_popular = true
                      endif
                      if variant.title contains '3'
                        assign is_best = true
                      endif
                    -%}
                    <label class="bundle {% if variant.id == current_variant.id %}active{% endif %} {% if is_popular or is_best %}glow{% endif %}">
                      <input type="radio" name="variant-radio" value="{{ variant.id }}"
                        data-price="{{ variant.price }}"
                        data-sub-price="{{ v_sub_price }}"
                        data-compare="{{ variant.compare_at_price | default: 0 }}"
                        data-available="{{ variant.available }}"
                        {% if variant.id == current_variant.id %}checked{% endif %} hidden>

                      {%- if is_popular -%}<span class="tier-badge popular">★ Most Popular</span>{%- endif -%}
                      {%- if is_best -%}<span class="tier-badge best">🏆 Best Value</span>{%- endif -%}

                      <div class="bundle-row">
                        <span class="dot"></span>
                        <span class="bt">
                          {{ variant.title }}
                          {%- if variant.compare_at_price > variant.price -%}
                            <span class="save">save {{ variant.compare_at_price | minus: variant.price | money }}</span>
                          {%- endif -%}
                        </span>
                        <span class="bp">
                          <span class="p">{{ variant.price | money }}</span>
                          {%- if variant.compare_at_price > variant.price -%}
                            <br><span class="u">{{ variant.compare_at_price | money }}</span>
                          {%- endif -%}
                        </span>
                      </div>

                      {%- if is_popular or is_best -%}
                        <div class="bonus-box">
                          🎁 <strong>Free bonus:</strong> the 5-Minute Plump Routine guide{% if is_best %} + free shipping{% endif %} —
                          <a href="#howtouse" class="bonus-link">included, see below</a>
                        </div>
                      {%- endif -%}
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endunless -%}

            {%- if has_sub and first_plan != blank -%}
              {%- assign cur_sub_price = current_variant.price -%}
              {%- for alloc in current_variant.selling_plan_allocations -%}
                {%- if alloc.selling_plan.id == first_plan.id -%}{%- assign cur_sub_price = alloc.price -%}{%- endif -%}
              {%- endfor -%}
              <div class="opt-label">{{ s.purchase_label | default: 'Purchase type' }}</div>
              <div class="subbox">
                <label class="subopt active">
                  <input type="radio" name="purchase-type" value="subscribe" data-selling-plan="{{ first_plan.id }}" checked hidden>
                  <span class="dot"></span>
                  <span class="subt">
                    {{ s.sub_label | default: 'Subscribe &amp; Save' }}
                    <span class="subm">{{ first_plan.name }} · cancel anytime</span>
                  </span>
                  <span class="subp">
                    <span class="p">{{ cur_sub_price | money }}</span>
                    {%- if current_variant.price > cur_sub_price -%}<br><span class="u">{{ current_variant.price | money }}</span>{%- endif -%}
                  </span>
                </label>
                <label class="subopt">
                  <input type="radio" name="purchase-type" value="onetime" data-selling-plan="" hidden>
                  <span class="dot"></span>
                  <span class="subt">One-time purchase</span>
                  <span class="subp"><span class="p">{{ current_variant.price | money }}</span></span>
                </label>
              </div>
              <input type="hidden" name="selling_plan" id="selling-plan-input" value="{{ first_plan.id }}">
            {%- endif -%}

            <div class="qty">
              <span class="opt-label" style="margin:0">Qty</span>
              <div class="stepper">
                <button type="button" id="qtyMinus" aria-label="Decrease">&minus;</button>
                <input type="number" id="quantity" name="quantity" value="1" min="1" inputmode="numeric">
                <button type="button" id="qtyPlus" aria-label="Increase">+</button>
              </div>
            </div>

            <div class="buy-actions">
              <button type="submit" name="add" id="addBtn" class="btn"
                data-label="{{ s.add_label | default: 'Add to Cart' }}"
                {% unless current_variant.available %}disabled{% endunless %}>
                <span>{% if current_variant.available %}{{ s.add_label | default: 'Add to Cart' }}{% else %}Sold out{% endif %}</span><span id="addBtnPrice"></span>
              </button>
              {{ form | payment_button }}
            </div>
          {%- endform -%}
        {%- else -%}
          <p style="color:var(--ink-soft)"><em>Assign a product to this template in the theme editor to enable checkout.</em></p>
        {%- endif -%}

        <div class="pay-row">
          <span>VISA</span><span>MASTERCARD</span><span>AMEX</span><span>PAYPAL</span><span>SHOP PAY</span><span>G PAY</span>
        </div>
        <div class="assur">
          <div>{{ s.assur1 | default: '30-Day Money-Back Guarantee — plump in 5 minutes or refund' }}</div>
          <div>{{ s.assur2 | default: 'Free shipping on all bundles' }}</div>
          <div>{{ s.assur3 | default: 'Ships in 24–48 hours with tracking' }}</div>
        </div>

        <div class="acc">
          <details open>
            <summary>Key Ingredients</summary>
            <div class="rte">{{ p.metafields.custom.ingredients | default: "<ul><li><strong>Spicy Tingle Complex</strong> (capsicum, ginger root, wintergreen) — a gentle buzz, not a burn: enough warmth to draw blood flow for instant plump, dosed low enough not to sting</li><li><strong>No cinnamon</strong> — cinnamal is one of the most common lip-irritant allergens in tingle formulas, so we left it out</li><li><strong>Tri-Peptide Blend</strong> — smoother texture with daily use</li><li><strong>Hyaluronic Acid + Vitamin E</strong> — draws moisture in and locks it there, so lips stay soft instead of drying out with repeat use like most tingle glosses</li><li>Vegan · cruelty-free · no parabens · dermatologist-tested</li></ul>" }}</div>
          </details>
          <details id="howtouse">
            <summary>How to Use</summary>
            <div class="rte">{{ p.metafields.custom.how_to_use | default: "<p>Sweep <strong>one thin layer</strong> over clean lips — this is the #1 thing that determines whether you feel a pleasant tingle or an unpleasant sting. Expect warmth within 60 seconds and visible plump in about 5 minutes, lasting 2–4 hours. Wear alone as a gloss, as a base under lip liner and lipstick, or dab over the top for extra shine. Patch-test on your inner wrist before first use if you have sensitive skin.</p>" }}</div>
          </details>
          <details>
            <summary>Shipping &amp; Returns</summary>
            <div class="rte">{{ s.shipping_text | default: '<p>Orders are processed within 24–48 hours. Delivery is typically 5–9 business days with tracking emailed on dispatch. Bundles ship free. Not happy? Contact us within 30 days for a full refund — no need to return the tube.</p>' }}</div>
          </details>
        </div>

        <div class="compare">
          <div class="opt-label" style="margin-bottom:12px">How it stacks up</div>
          <div class="compare-grid">
            <div class="compare-row compare-head"><span></span><span>This</span><span>Old tingle plumpers</span><span>Injectable filler</span></div>
            <div class="compare-row"><span>Cost</span><span class="win">{{ current_variant.price | money }}</span><span>$15&ndash;$30</span><span>$500+</span></div>
            <div class="compare-row"><span>Needles</span><span class="win">None</span><span>None</span><span>Yes</span></div>
            <div class="compare-row"><span>Dries out lips</span><span class="win">No &mdash; hydrates</span><span>Often</span><span>N/A</span></div>
            <div class="compare-row"><span>Downtime</span><span class="win">None</span><span>None</span><span>Days of swelling</span></div>
            <div class="compare-row"><span>Commitment</span><span class="win">Reapply anytime</span><span>Reapply anytime</span><span>Appointment + upkeep</span></div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "rating_text", "label": "Rating line", "default": "4.7 · 2,000+ verified reviews" },
    { "type": "text", "id": "option_label", "label": "Variant chooser label", "default": "Choose your option" },
    { "type": "text", "id": "purchase_label", "label": "Purchase-type label (subscriptions)", "default": "Purchase type" },
    { "type": "text", "id": "sub_label", "label": "Subscribe option label", "default": "Subscribe & Save" },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to Cart" },
    { "type": "text", "id": "assur1", "label": "Assurance 1", "default": "30-Day Money-Back Guarantee — plump in 5 minutes or refund" },
    { "type": "text", "id": "assur2", "label": "Assurance 2", "default": "Free shipping on all bundles" },
    { "type": "text", "id": "assur3", "label": "Assurance 3", "default": "Ships in 24–48 hours with tracking" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping & returns text" }
  ]
}
{% endschema %}
