{%- assign contact_email = section.settings.contact_email | default: 'plumptheoryshop@gmail.com' -%}
<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <h4>{{ section.settings.brand_name | default: shop.name }}</h4>
        <p style="opacity:.8;max-width:280px">{{ section.settings.blurb | default: 'A needle-free, tingling peptide lip plumper for instant volume and softer, more defined lips over time.' }}</p>
        {%- if contact_email != blank -%}
          <p style="margin-top:12px;opacity:.9">Contact us:<br><a href="mailto:{{ contact_email }}" style="text-decoration:underline">{{ contact_email }}</a></p>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {%- if block.settings.menu != blank -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- else -%}
        <div>
          <h4>Shop</h4>
          <a href="{{ routes.all_products_collection_url }}">All products</a>
        </div>
        <div>
          <h4>Help</h4>
          <a href="mailto:{{ contact_email }}">Contact us</a>
          <a href="{{ routes.root_url }}policies/shipping-policy">Shipping &amp; delivery</a>
          <a href="{{ routes.root_url }}policies/refund-policy">Returns &amp; refunds</a>
        </div>
        <div>
          <h4>Legal</h4>
          <a href="{{ routes.root_url }}policies/terms-of-service">Terms of service</a>
          <a href="{{ routes.root_url }}policies/privacy-policy">Privacy policy</a>
          <a href="{{ routes.root_url }}policies/refund-policy">Refund policy</a>
        </div>
      {%- endfor -%}
    </div>

    <div class="fine">
      {{ section.settings.disclaimer | default: '*Individual results vary. This product is a cosmetic and is not intended to diagnose, treat, cure or prevent any condition. Patch-test before first use and discontinue if irritation occurs. Not for use on broken or chapped skin. Keep out of reach of children.' }}
      <br><br>
      &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. Prices in {{ cart.currency.iso_code }}.
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Spicy Lip Plumper" },
    { "type": "textarea", "id": "blurb", "label": "Short blurb", "default": "A needle-free, tingling peptide lip plumper for instant volume and softer, more defined lips over time." },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "plumptheoryshop@gmail.com" },
    { "type": "textarea", "id": "disclaimer", "label": "Legal disclaimer" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ]
}
{% endschema %}
