{%- assign s = section.settings -%}
{%- capture cta_url -%}{%- render 'shop-url', section_product: s.product -%}{%- endcapture -%}
{%- assign cta_url = cta_url | strip -%}
{%- capture offer -%}{%- render 'featured-offer', section_product: s.product -%}{%- endcapture -%}
{%- assign offer_parts = offer | strip | split: '|' -%}
{%- assign o_price = offer_parts[0] -%}
{%- assign o_was = offer_parts[1] -%}
{%- assign o_pct = offer_parts[2] | plus: 0 -%}

<header class="hero">
  <div class="wrap">
    <div>
      <div class="stars"><b>★★★★★</b> {{ s.rating_text | default: '4.7 · 2,000+ reviews' }}</div>
      <div class="eyebrow lipfade">{{ s.problem_line | default: 'Noticing Lip Fade? Your lips didn’t vanish — they faded.' }}</div>
      <h1>{{ s.heading | default: 'Fuller Lips in 5 Minutes.<br>No Needles. No Filler.' }}</h1>
      <p class="sub">{{ s.subheading | default: "Swipe it on, feel a warm tingle, and watch your lips look fuller, smoother and more defined in about five minutes. Hyaluronic acid keeps them soft and plump for hours, with none of the dry, cracked aftermath other plumpers leave." }}</p>

      <ul class="ticks">
        {%- assign ticks = s.ticks | default: 'Visibly fuller lips in about 5 minutes|Warm tingle, not a burn. Cinnamon-free|Try it for 30 days or get your money back' | split: '|' -%}
        {%- for t in ticks -%}<li>{{ t | strip }}</li>{%- endfor -%}
      </ul>

      <div class="price">
        <span class="now">{{ s.price | default: o_price }}</span>
        {%- if s.compare_price != blank -%}<span class="was">{{ s.compare_price }}</span>{%- elsif o_was != blank -%}<span class="was">{{ o_was }}</span>{%- endif -%}
        {%- if s.badge != blank -%}<span class="off">{{ s.badge }}</span>{%- elsif o_pct > 0 -%}<span class="off">{{ o_pct }}% OFF</span>{%- endif -%}
      </div>

      <div class="cta-row">
        <a href="{{ cta_url }}" class="btn big">{%- if s.cta_primary != blank -%}{{ s.cta_primary }}{%- elsif o_pct > 0 -%}Get Fuller Lips Now{%- else -%}Get Fuller Lips Now{%- endif -%}</a>
        {%- if s.cta_secondary != blank -%}
          <a href="#how" class="btn ghost big">{{ s.cta_secondary }}</a>
        {%- endif -%}
      </div>

      {%- if s.urgency != blank -%}<p class="urgency">{{ s.urgency }}</p>{%- endif -%}

      <p class="promise"><strong>Love your lips in 30 days or your money back.</strong></p>

      <p class="burn-note"><strong>Will it burn?</strong> No &mdash; it&rsquo;s a warm tingle that fades in minutes, not a burn. Sensitive lips? Start with one thin layer.</p>

      <div class="angles">
        <div><strong>Skipping filler?</strong> Get the full-lip look without the needle.</div>
        <div><strong>Want your lips back?</strong> Bring back the fullness and color you&rsquo;ve noticed fading.</div>
      </div>
    </div>

    <div class="hero-media">
      {%- if s.float_one != blank -%}<div class="float one">{{ s.float_one }}</div>{%- endif -%}
      <div class="hero-card">
        <div class="shot">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 900 | image_tag: alt: 'Spicy Lip Plumping Oil', loading: 'eager' }}
          {%- elsif s.product != blank and s.product.featured_image -%}
            {{ s.product.featured_image | image_url: width: 900 | image_tag: alt: s.product.title, loading: 'eager' }}
          {%- elsif settings.featured_product != blank and settings.featured_product.featured_image -%}
            {{ settings.featured_product.featured_image | image_url: width: 900 | image_tag: alt: settings.featured_product.title, loading: 'eager' }}
          {%- else -%}
            <img src="{{ 'plumper-1.jpg' | asset_url }}" alt="Spicy Lip Plumping Oil" width="600" height="600">
          {%- endif -%}
        </div>
      </div>
      {%- if s.float_two != blank -%}<div class="float two">{{ s.float_two }}</div>{%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "product", "id": "product", "label": "Product the CTAs link to" },
    { "type": "text", "id": "rating_text", "label": "Rating line", "default": "4.7 · 2,000+ reviews" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Fuller Lips in 5 Minutes. No Needles. No Filler.</p>" },
    { "type": "textarea", "id": "subheading", "label": "Sub-heading", "default": "Swipe it on, feel a warm tingle, and watch your lips look fuller, smoother and more defined in about five minutes. Hyaluronic acid keeps them soft and plump for hours, with none of the dry, cracked aftermath other plumpers leave." },
    { "type": "text", "id": "ticks", "label": "Trust ticks (separate with |)", "default": "Visibly fuller lips in about 5 minutes|Warm tingle, not a burn. Cinnamon-free|Try it for 30 days or get your money back" },
    { "type": "text", "id": "price", "label": "Price (leave blank to use the product's real price)" },
    { "type": "text", "id": "compare_price", "label": "Compare-at price (leave blank to use the product's real one)" },
    { "type": "text", "id": "badge", "label": "Discount badge (leave blank to calculate it)" },
    { "type": "text", "id": "problem_line", "label": "Problem line above the headline", "default": "Noticing Lip Fade? Your lips didn’t vanish — they faded." },
    { "type": "text", "id": "cta_primary", "label": "Primary button text (blank = Get Fuller Lips Now)" },
    { "type": "text", "id": "cta_secondary", "label": "Secondary button text", "default": "See How It Works" },
    { "type": "text", "id": "urgency", "label": "Urgency line", "default": "Ships in 24–48 hours with tracking" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "float_one", "label": "Floating badge (top-left) HTML", "default": "Dermatologist-tested<span class=\"big\">0 needles</span>" },
    { "type": "text", "id": "float_two", "label": "Floating badge (bottom-right) HTML", "default": "<span class=\"big\">+ Instant</span>visible plump" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
