{%- liquid
  assign announce = section.settings.announcement | default: 'FREE US SHIPPING · 4.7 ★ 2,000+ reviews · 30-DAY MONEY-BACK GUARANTEE'
-%}
{%- capture cta_url -%}{%- render 'shop-url', section_product: section.settings.button_product -%}{%- endcapture -%}
{%- assign cta_url = cta_url | strip -%}

{%- if announce != blank -%}
  <div class="announce">{{ announce }}</div>
{%- endif -%}

<div class="nav">
  <div class="wrap">
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ settings.brand_name | default: 'Plump Theory' }} — home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 500 | image_tag: alt: settings.brand_name | default: 'Plump Theory', class: 'logo-img' }}
      {%- else -%}
        <img class="logo-img" src="{{ 'logo.png' | asset_url }}" alt="{{ settings.brand_name | default: 'Plump Theory' }}" width="954" height="448">
      {%- endif -%}
    </a>

    <nav class="nav-links">
      {%- assign contact_url = routes.root_url | append: 'pages/contact' -%}
      {%- for link in section.settings.menu.links -%}
        {%- assign lt = link.title | downcase -%}
        {%- if lt contains 'contact' -%}
          <a href="{{ contact_url }}" class="hide-sm">{{ link.title }}</a>
        {%- elsif lt contains 'review' -%}
          {%- comment -%} handled by the dedicated Reviews link below {%- endcomment -%}
        {%- else -%}
          <a href="{{ link.url }}" class="hide-sm">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- assign reviews_label = section.settings.reviews_label | default: 'Reviews' -%}
      {%- if reviews_label != blank -%}
        <a href="{{ routes.root_url }}#reviews" class="hide-sm">{{ reviews_label }}</a>
      {%- endif -%}
      <a href="{{ cta_url }}" class="btn nav-cta">{{ section.settings.button_label | default: 'Shop Now' }}</a>
      <button type="button" class="nav-cart" data-cd-open aria-label="Open cart">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="nav-cart__count{% if cart.item_count == 0 %} is-zero{% endif %}" data-cd-count>{{ cart.item_count }}</span>
      </button>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "default": "FREE US SHIPPING · 4.7 ★ 2,000+ reviews · 30-DAY MONEY-BACK GUARANTEE" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "brand_name", "label": "Brand name (if no logo image)", "default": "Plump Theory" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" },
    { "type": "text", "id": "reviews_label", "label": "Reviews link label (blank to hide)", "default": "Reviews" },
    { "type": "product", "id": "button_product", "label": "Shop Now button → product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" }
  ]
}
{% endschema %}
