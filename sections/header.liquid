{%- liquid
  assign announce = section.settings.announcement | default: 'FREE SHIPPING ON BUNDLES · 4.9 ★ 12,000+ reviews · 30-DAY MONEY-BACK GUARANTEE'
-%}

{%- if announce != blank -%}
  <div class="announce">{{ announce }}</div>
{%- endif -%}

<div class="nav">
  <div class="wrap">
    <a href="{{ routes.root_url }}" class="logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 240 | image_tag: alt: shop.name, style: 'max-height:34px;width:auto' }}
      {%- else -%}
        {{ section.settings.brand_name | default: shop.name }}
      {%- endif -%}
    </a>

    <nav class="nav-links">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="hide-sm">{{ link.title }}</a>
      {%- endfor -%}
      {%- if section.settings.button_product != blank -%}
        <a href="{{ section.settings.button_product.url }}" class="btn nav-cta">{{ section.settings.button_label | default: 'Shop Now' }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="btn nav-cta">{{ section.settings.button_label | default: 'Shop Now' }}</a>
      {%- endif -%}
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "default": "FREE SHIPPING ON BUNDLES · 4.9 ★ 12,000+ reviews · 30-DAY MONEY-BACK GUARANTEE" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "brand_name", "label": "Brand name (if no logo image)", "default": "Spicy Lip Plumper" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" },
    { "type": "product", "id": "button_product", "label": "Shop Now button → product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" }
  ]
}
{% endschema %}
