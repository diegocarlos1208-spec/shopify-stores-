{%- liquid
  assign announce = section.settings.announcement | default: 'FREE SHIPPING ON BUNDLES · 4.7 ★ 2,000+ reviews · 30-DAY MONEY-BACK GUARANTEE'
-%}
{%- capture cta_url -%}{%- render 'shop-url', section_product: section.settings.button_product -%}{%- endcapture -%}
{%- assign cta_url = cta_url | strip -%}

{%- if announce != blank -%}
  <div class="announce">{{ announce }}</div>
{%- endif -%}

<div class="nav">
  <div class="wrap">
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }} — home">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 500 | image_tag: alt: shop.name, class: 'logo-img' }}
      {%- else -%}
        <img class="logo-img" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="954" height="448">
      {%- endif -%}
    </a>

    <nav class="nav-links">
      {%- assign contact_email = section.settings.contact_email | default: 'plumptheoryshop@gmail.com' -%}
      {%- for link in section.settings.menu.links -%}
        {%- assign lt = link.title | downcase -%}
        {%- if lt contains 'contact' and contact_email != blank -%}
          <a href="mailto:{{ contact_email }}" class="hide-sm">{{ link.title }}</a>
        {%- elsif lt contains 'review' -%}
          {%- comment -%} handled by the dedicated Reviews link below {%- endcomment -%}
        {%- else -%}
          <a href="{{ link.url }}" class="hide-sm">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- assign reviews_label = section.settings.reviews_label | default: 'Reviews' -%}
      {%- if reviews_label != blank -%}
        <a href="{{ routes.root_url }}#reviews" class="hide-sm">{{ reviews_label }}</a>
      {%- endif -%}
      <a href="{{ cta_url }}" class="btn nav-cta">{{ section.settings.button_label | default: 'Shop Now' }}</a>
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "default": "FREE SHIPPING ON BUNDLES · 4.7 ★ 2,000+ reviews · 30-DAY MONEY-BACK GUARANTEE" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "brand_name", "label": "Brand name (if no logo image)", "default": "Spicy Lip Plumper" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu", "default": "main-menu" },
    { "type": "text", "id": "contact_email", "label": "Contact email (menu \"Contact\" opens this)", "default": "plumptheoryshop@gmail.com" },
    { "type": "text", "id": "reviews_label", "label": "Reviews link label (blank to hide)", "default": "Reviews" },
    { "type": "product", "id": "button_product", "label": "Shop Now button → product" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" }
  ]
}
{% endschema %}
