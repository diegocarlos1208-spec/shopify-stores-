<div class="wrap" style="padding:64px 22px;max-width:420px;margin:0 auto">
  <h1 style="font-family:var(--serif);color:var(--wine-deep);margin-bottom:18px">{{ 'customer.register.title' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <input type="text" name="customer[first_name]" placeholder="First name" class="fld">
    <input type="text" name="customer[last_name]" placeholder="Last name" class="fld">
    <input type="email" name="customer[email]" placeholder="Email" class="fld">
    <input type="password" name="customer[password]" placeholder="Password" class="fld">
    <button type="submit" class="btn" style="width:100%">Create</button>
  {%- endform -%}
</div>
