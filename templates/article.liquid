<div class="wrap" style="padding:64px 22px;max-width:720px;margin:0 auto">
  <h1 style="font-family:var(--serif);color:var(--wine-deep);margin-bottom:8px">{{ article.title }}</h1>
  <p style="font-size:.85rem;color:var(--ink-soft);margin-bottom:24px">{{ article.published_at | date: "%B %-d, %Y" }}</p>
  <div class="rte">{{ article.content }}</div>
</div>
