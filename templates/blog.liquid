<div class="wrap" style="padding:64px 22px;max-width:820px;margin:0 auto">
  <h1 style="font-family:var(--serif);color:var(--wine-deep);margin-bottom:24px">{{ blog.title }}</h1>
  {%- for article in blog.articles -%}
    <a href="{{ article.url }}" style="display:block;padding:18px 0;border-bottom:1px solid var(--line)">
      <span style="font-weight:600;color:var(--wine-deep)">{{ article.title }}</span>
      <span style="display:block;font-size:.85rem;color:var(--ink-soft)">{{ article.published_at | date: "%B %-d, %Y" }}</span>
    </a>
  {%- endfor -%}
</div>
