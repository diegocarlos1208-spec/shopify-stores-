<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@400;500;600;700&display=swap">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-password">
  <main class="wrap" style="padding:90px 22px;max-width:520px;margin:0 auto;text-align:center">
    <h1 style="font-family:var(--serif);color:var(--wine-deep)">{{ shop.name }}</h1>
    <p style="color:var(--ink-soft);margin:14px 0 24px">{{ shop.password_message }}</p>
    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Enter store password" style="padding:14px 16px;border:1px solid var(--line);border-radius:12px;width:100%;max-width:320px">
      <div style="margin-top:14px"><button type="submit" class="btn">Enter</button></div>
    {%- endform -%}
    {{ content_for_layout }}
  </main>
</body>
</html>
