<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="{{ settings.color_wine }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-plump-theory-32.png' | asset_url }}">
    <link rel="icon" type="image/png" sizes="180x180" href="{{ 'favicon-plump-theory-180.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'favicon-plump-theory-180.png' | asset_url }}">
  {%- endif -%}

  <title>{{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% assign brand = settings.brand_name | default: 'Plump Theory' %}{% unless page_title contains brand %} &ndash; {{ brand }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@400;500;600;700&display=swap">
  {{ 'base.css' | asset_url | stylesheet_tag }}

  <style>
    :root{
      --bg:{{ settings.color_bg }};
      --ink:{{ settings.color_ink }};
      --coral-deep:{{ settings.color_accent }};
      --wine-deep:{{ settings.color_wine }};
    }
    /* No express / dynamic checkout buttons (Shop Pay, Buy it now, etc.) */
    .shopify-payment-button,
    .additional-checkout-buttons,
    [data-shopify="payment-button"],
    shopify-accelerated-checkout,
    shopify-accelerated-checkout-cart{display:none!important}
  </style>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}--{{ template.suffix }}{% endif %}">
  <a class="skip-to-content-link visually-hidden" href="#MainContent">Skip to content</a>

  {% section 'header' %}

  <main id="MainContent" class="content-for-layout" role="main">
    {{ content_for_layout }}
  </main>

  <script>
    (function () {
      // Mini-FAQ belongs below the buy buttons (Add to Cart / Buy with Shop),
      // not between the bundle box and the purchase-type selector.
      var faq = document.querySelector('.mini-faq');
      var form = document.getElementById('product-form');
      if (faq && form && form.parentNode) {
        form.parentNode.insertBefore(faq, form.nextSibling);
      }

      // Trim the PDP description blurb down to its first sentence.
      var blurb = document.querySelector('.pdp .blurb');
      if (blurb) {
        var firstSentence = blurb.textContent.trim().split('.')[0];
        if (firstSentence) blurb.textContent = firstSentence + '.';
      }

      // "Will it burn?" answered right under the blurb (not buried in the FAQ).
      // The lip mask has no tingle, so it doesn't get this note.
      if (blurb && !document.querySelector('.pdp .burn-note') && document.body.className.indexOf('lip-mask') === -1) {
        var note = document.createElement('p');
        note.className = 'burn-note';
        note.innerHTML = '<strong>Will it burn?</strong> No \u2014 it\u2019s a warm tingle that fades in minutes, not a burn. Sensitive lips? Start with one thin layer.';
        blurb.parentNode.insertBefore(note, blurb.nextSibling);
      }

      // The 30-day promise as a bold box right under the buy button.
      var buy = document.querySelector('.buy-actions');
      if (buy && !document.querySelector('.promise-box') && document.body.className.indexOf('lip-mask') === -1) {
        var box = document.createElement('div');
        box.className = 'promise-box';
        box.innerHTML = '<strong>Love your lips in 30 days or your money back.</strong><span>Not happy? Contact us for a full refund \u2014 no need to send it back.</span>';
        buy.parentNode.insertBefore(box, buy.nextSibling);
      }
      var assur = document.querySelector('.assur > div');
      if (assur && /plump in 5 minutes/i.test(assur.textContent)) assur.textContent = '30-day money-back promise \u2014 love your lips or get a refund';

      // Say why the bigger packs exist instead of only showing a discount (numbers come from the live variants).
      var bundles = document.querySelector('.offer-card .bundles');
      if (bundles && !document.querySelector('.bundle-why')) {
        var best = null, bestN = 0;
        document.querySelectorAll('input[name="variant-radio"]').forEach(function (r) {
          var lab = r.closest('label'), t = lab && lab.querySelector('.bt');
          var n = t ? parseInt(t.textContent, 10) : 0;
          if (n > bestN) { bestN = n; best = r; }
        });
        if (best && bestN > 1) {
          var each = (parseFloat(best.getAttribute('data-price')) / 100 / bestN).toFixed(2);
          var why = document.createElement('p');
          why.className = 'bundle-why';
          why.innerHTML = 'Stock up so you never run out: the ' + bestN + '-pack drops to <strong>$' + each + ' a bottle</strong>.';
          bundles.parentNode.insertBefore(why, bundles.nextSibling);
        }
      }

      // The bundle discount pill only applies to the best-value pack, so say which one.
      var pill = document.querySelector('.offer-pill');
      if (pill && !/only/i.test(pill.textContent)) {
        var best = null, bestPct = 0;
        document.querySelectorAll('input[name="variant-radio"]').forEach(function (r) {
          var p = parseFloat(r.getAttribute('data-price')), c = parseFloat(r.getAttribute('data-compare'));
          if (c > p && (c - p) / c > bestPct) { bestPct = (c - p) / c; best = r; }
        });
        var bt = best && best.closest('label') && best.closest('label').querySelector('.bt');
        var packName = bt && bt.firstChild && bt.firstChild.textContent.trim();
        if (packName) pill.textContent = pill.textContent.trim() + ' \u00b7 ' + packName.toUpperCase() + ' ONLY';
      }
    })();
  </script>

  {% section 'footer' %}

  {% render 'cart-drawer' %}

  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
